 "subs": [
  {
   "t0": 0.4,
   "t1": 2.814,
   "text": "Apakah kesempatan untuk hidup di Indonesia"
  },
  {
   "t0": 2.768,
   "t1": 4.837,
   "text": "bergantung pada tebalnya dompet?"
  },
  {
   "t0": 5.43,
   "t1": 7.43,
   "text": "LA, 17 tahun."
  },
  {
   "t0": 7.45,
   "t1": 9.868,
   "text": "Luka bakar sekitar 80 persen."
  },
  {
   "t0": 9.888,
   "t1": 12.655,
   "text": "Ia dirawat intensif, lalu meninggal dunia."
  },
  {
   "t0": 12.675,
   "t1": 14.64,
   "text": "Kasusnya kini diproses hukum."
  },
  {
   "t0": 14.66,
   "t1": 16.602,
   "text": "Tapi ada pertanyaan yang tertinggal:"
  },
  {
   "t0": 16.622,
   "t1": 19.248,
   "text": "apakah semua kesempatan sudah tersedia?"
  },
  {
   "t0": 19.84,
   "t1": 23.361,
   "text": "Bagaimana jika sejak awal ia ditangani di burn center kelas dunia?"
  },
  {
   "t0": 23.381,
   "t1": 26.259,
   "text": "Fasilitas, pengalaman tim, dan teknologi"
  },
  {
   "t0": 26.179,
   "t1": 27.889,
   "text": "memang bisa memengaruhi hasil."
  },
  {
   "t0": 27.909,
   "t1": 29.557,
   "text": "Tapi tidak ada yang bisa memastikan"
  },
  {
   "t0": 29.465,
   "t1": 31.057,
   "text": "hasilnya akan berbeda."
  },
  {
   "t0": 31.63,
   "t1": 36.494,
   "text": "Pilihan fasilitas pasien JKN, asuransi swasta, dan pasien umum"
  },
  {
   "t0": 36.39,
   "t1": 37.334,
   "text": "bisa berbeda."
  },
  {
   "t0": 37.354,
   "t1": 39.071,
   "text": "Tapi itu tidak otomatis berarti"
  },
  {
   "t0": 38.979,
   "t1": 41.268,
   "text": "kualitas keputusan medisnya berbeda."
  },
  {
   "t0": 41.86,
   "t1": 45.486,
   "text": "Kasus ekstrem bisa butuh ICU panjang, operasi berulang,"
  },
  {
   "t0": 45.506,
   "t1": 46.96,
   "text": "sampai dukungan organ."
  },
  {
   "t0": 46.98,
   "t1": 49.851,
   "text": "Apakah skema pembiayaan kita cukup adaptif?"
  },
  {
   "t0": 49.871,
   "t1": 52.846,
   "text": "Belum ada bukti tarif menyebabkan kematian siapa pun."
  },
  {
   "t0": 52.866,
   "t1": 54.609,
   "text": "Tapi pertanyaannya sah."
  },
  {
   "t0": 55.19,
   "t1": 59.02,
   "text": "Yang perlu dibenahi: pusat rujukan khusus, sebaran spesialis,"
  },
  {
   "t0": 59.021,
   "t1": 60.425,
   "text": "pembiayaan kasus kompleks,"
  },
  {
   "t0": 60.426,
   "t1": 63.11,
   "text": "dan sistem rujukan cepat berbasis kompetensi."
  },
  {
   "t0": 78.63,
   "t1": 81.013,
   "text": "Kesehatan adalah hak, bukan privilege."
  },
  {
   "t0": 81.033,
   "t1": 83.765,
   "text": "Menurut kamu, sistem kesehatan kita sudah cukup adil?"
  },
  {
   "t0": 83.785,
   "t1": 86.225,
   "text": "Save, share, dan diskusikan."
  }
 ],
